{
  "name": "aigent-workspace",
  "version": "1.1.0",
  "private": true,
  "description": "Monorepo for Aigent CLI & VS Code / Antigravity Extension",
  "type": "module",
  "workspaces": [
    "cli",
    "extension"
  ],
  "scripts": {
    "cli:link": "cd cli && npm link",
    "sync:all": "node scripts/sync-all.js",
    "build": "node scripts/sync-all.js",
    "extension:package": "npm --prefix extension run package",
    "extension:install:agy": "antigravity-ide --install-extension extension/aigent-vscode-1.1.0.vsix --force"
  },
  "keywords": [
    "ai",
    "antigravity",
    "rules",
    "vscode-extension",
    "cli"
  ],
  "author": "Mahmoud Amin",
  "license": "MIT"
}
